+test('KaTeX updated API: normal formula output and untrusted URL control',()=>{
+ const html=katex.renderToString('c^2 = a^2 + b^2',{throwOnError:false,trust:false});
+ assert.match(html,/katex/);assert.match(html,/<math/);
