import express from 'express';
import cookieParser from 'cookie-parser';
import fs from 'node:fs/promises';
import path from 'node:path';
import {execFileSync} from 'node:child_process';
const root=path.resolve('fixtures');
await fs.mkdir(root,{recursive:true});
process.env.DATA_DIR=path.join(root,'data');
process.env.VAULT_PATH=path.join(root,'vault');
process.env.WEBOBSIDIAN_PASSWORD='fixture-recovery-only';
const {updateSettings}=await import('../server/src/services/settings.ts');
const vault=await import('../server/src/services/vault.ts');
const git=await import('../server/src/services/git.ts');
const {filesRouter}=await import('../server/src/routes/files.ts');
const {authRouter}=await import('../server/src/routes/auth.ts');
const {gitRouter}=await import('../server/src/routes/git.ts');
const {errorHandler}=await import('../server/src/middleware/error.ts');
const {issueToken,issueGuestToken}=await import('../server/src/services/auth.ts');
const repo=process.env.VAULT_PATH;
await fs.mkdir(path.join(repo,'content/allowed'),{recursive:true});
await fs.mkdir(path.join(repo,'content/private'),{recursive:true});
await fs.mkdir(path.join(root,'outside'),{recursive:true});
await updateSettings(s=>{s.vault.path=repo;s.vault.root='content';s.vault.deleteMode='permanent';s.vault.attachmentDir='attachments';s.publicEditor.enabled=true;s.publicEditor.editableRoot='content/allowed';s.upload.enabled=false;s.git.enabled=false;s.git.remote='';s.git.lfsPatterns=[];s.github.autoFollowBase=false;s.github.autoPullRequest=false;});
const app=express();app.use(express.json({limit:'32mb'}));app.use(cookieParser());app.use('/api/files',filesRouter);app.use('/api/git',gitRouter);app.use('/auth',authRouter);app.use(errorHandler);
const server=await new Promise(r=>{const s=app.listen(0,'127.0.0.1',()=>r(s));});
const base='http://127.0.0.1:'+server.address().port;
const results=[];
async function request(id,method,url,body,headers={}){
 const res=await fetch(base+url,{method,headers:body instanceof FormData?headers:{'Content-Type':'application/json',...headers},body:body?body instanceof FormData?body:JSON.stringify(body):undefined});
 let data=await res.text();try{data=JSON.parse(data)}catch{}
 results.push({id,status:res.status,...(data?.path?{path:data.path}:{}),...(data?.error?{error:data.error}:{}),...(data?.content?{content:data.content}: {})});return res;
}
async function put(id,p){await request(id,'PUT','/api/files/content',{path:p,content:'FIXTURE-'+id});}
await put('allowed-write','allowed/ok.md');
await put('direct-denied','private/no.md');
await put('dotdot-write','allowed/../private/dotdot.md');
await put('outside-content-denied','allowed/../../outside.md');
await put('backslash-linux-literal','allowed/..\\private\\literal.md');
await put('encoded-json-literal','allowed/%2e%2e/private/literal.md');
await fs.writeFile(path.join(repo,'content/private/read.md'),'PRIVATE-FIXTURE');
await request('read-outside-editable','GET','/api/files/content?path=private/read.md');
await request('read-encoded-dotdot','GET','/api/files/content?path=allowed%2F..%2Fprivate%2Fread.md');
await fs.symlink('../private',path.join(repo,'content/allowed/link'));
await put('symlink-to-private','allowed/link/sym.md');
await fs.symlink(path.join(root,'outside'),path.join(repo,'content/allowed/external'));
await put('symlink-outside-content-denied','allowed/external/no.md');
await request('rename-bypass','PATCH','/api/files/rename',{from:'allowed/ok.md',to:'allowed/../private/renamed.md'});
await request('copy-bypass','POST','/api/files/copy',{from:'allowed/../private/renamed.md',to:'allowed/../private/copied.md'});
await request('delete-encoded-bypass','DELETE','/api/files/?path=allowed%2F..%2Fprivate%2Fcopied.md');
for(const [id,url,dir]of [['upload-empty-dir','/api/files/upload',null],['upload-dotdot','/api/files/upload','allowed/../private'],['image-derived-target','/api/files/upload-image',null]]){
 const f=new FormData();if(dir!==null)f.set('dir',dir);f.set('file',new Blob(['FIXTURE'],{type:'image/png'}),id+'.png');await request(id,'POST',url,f);
}
await request('trash-guest-denied','GET','/api/files/trash');
const owner=await issueToken();const guest=await issueGuestToken();
await updateSettings(s=>{s.publicEditor.enabled=false;});
await request('closed-anon-denied','GET','/api/files/');
await request('closed-guest-denied','GET','/api/files/',null,{Authorization:'Bearer '+guest});
await request('closed-owner-allowed','GET','/api/files/',null,{Authorization:'Bearer '+owner});
await updateSettings(s=>{s.publicEditor.enabled=true;});
for(let i=0;i<11;i++)await request('login-wrong-'+i,'POST','/auth/login',{password:'fixture-wrong'});
for(let i=0;i<12;i++)await request('password-guess-'+i,'POST','/auth/change-password',{currentPassword:'fixture-wrong',newPassword:'fixture-replacement'});
await request('guest-default-password-change','POST','/auth/change-password',{currentPassword:'123456',newPassword:'fixture-replacement'});
const g=(...args)=>execFileSync('git',args,{cwd:repo,encoding:'utf8',env:{...process.env,GIT_CONFIG_NOSYSTEM:'1',GIT_CONFIG_GLOBAL:'/dev/null'},stdio:['ignore','pipe','pipe']}).trim();
g('init','-b','fixture-local');g('config','user.name','Fixture');g('config','user.email','fixture@example.invalid');
await fs.writeFile(path.join(repo,'outside-content.md'),'HISTORY-FIXTURE');
g('add','.');g('commit','-m','fixture initial');
await request('git-show-hash-path-injection','GET','/api/git/show?hash='+encodeURIComponent('HEAD:outside-content.md')+'&path=ignored');
await fs.writeFile(path.join(repo,'content/private/git-empty.md'),'PRIVATE-CHANGED');
await fs.writeFile(path.join(repo,'outside-content.md'),'STAGED-OUTSIDE');
g('add','outside-content.md');
await git.commitAll('修复: 隔离夹具',[]);
results.push({id:'git-empty-paths-commit',files:g('diff-tree','--no-commit-id','--name-only','-r','HEAD').split('\n')});
await fs.writeFile(path.join(repo,'content/private/git-glob.md'),'PRIVATE-GLOB');
await fs.writeFile(path.join(repo,'content/allowed/glob.md'),'ALLOWED-GLOB');
await git.commitAll('修复: 隔离路径模式',['allowed/../private/git-glob.md']);
results.push({id:'git-dotdot-path-commit',files:g('diff-tree','--no-commit-id','--name-only','-r','HEAD').split('\n')});
await fs.writeFile(path.join(repo,'content/allowed/dummy.md'),'DUMMY');
await fs.writeFile(path.join(repo,'content/private/glob2.md'),'PRIVATE-GLOB2');
await git.commitAll('修复: 隔离通配',['allowed/*']);
results.push({id:'git-glob-commit',files:g('diff-tree','--no-commit-id','--name-only','-r','HEAD').split('\n')});
await fs.writeFile(path.join(process.cwd(),'probe-results.json'),JSON.stringify(results,null,2));
console.log(JSON.stringify(results,null,2));
server.close();
setTimeout(()=>process.exit(0),100);
